// kuyash kullanıcısı mullvad-daemon servisini şifresiz başlatıp durdurabilsin
// (SwayNC kontrol panelindeki Mullvad butonları için).
// Sadece bu servis ve sadece aktif yerel oturum; başka hiçbir şeyi etkilemez.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "mullvad-daemon.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.user == "kuyash" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
